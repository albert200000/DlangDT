<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

	<extension id="DBuilder" name="DDT Project Builder" point="org.eclipse.core.resources.builders">
		<builder hasNature="true">
			<run class="io.github.albert200000.dlangdt.project.builder.DBuilder"></run>
		</builder>
	</extension>
	<extension id="DNature" name="DDT Project Nature" point="org.eclipse.core.resources.natures">
		<runtime>
			<run class="io.github.albert200000.dlangdt.project.builder.DNature"></run>
		</runtime>
		<builder id="io.github.albert200000.dlangdt.project.DBuilder"></builder>
	</extension>
	<extension point="org.eclipse.ui.commands">
		<category id="io.github.albert200000.dlangdt.project.dNature.category" name="DDT Project Nature Commands"></category>
		<command categoryId="io.github.albert200000.dlangdt.project.dNature.category" defaultHandler="io.github.albert200000.dlangdt.project.builder.AddRemoveDNatureHandler" id="io.github.albert200000.dlangdt.project.addRemoveDNature" name="Add/Remove DDT Project Nature"></command>
		<category id="io.github.albert200000.dlangdt.project.gomod.commands.category" name="Dub Commands"></category>
		<command categoryId="io.github.albert200000.dlangdt.project.gomod.commands.category" defaultHandler="io.github.albert200000.dlangdt.project.gomod.commands.DubDownloadHandler" id="io.github.albert200000.dlangdt.project.gomod.commands.download" name="dub fetch"></command>
		<command categoryId="io.github.albert200000.dlangdt.project.gomod.commands.category" defaultHandler="io.github.albert200000.dlangdt.project.gomod.commands.DubTidyHandler" id="io.github.albert200000.dlangdt.project.gomod.commands.tidy" name="dub fetch"></command>
		<command categoryId="io.github.albert200000.dlangdt.project.gomod.commands.category" defaultHandler="io.github.albert200000.dlangdt.project.gomod.commands.DubVendorHandler" id="io.github.albert200000.dlangdt.project.gomod.commands.vendor" name="dub fetch"></command>
	</extension>
	<extension point="org.eclipse.ui.menus">
		<menuContribution locationURI="popup:org.eclipse.ui.projectConfigure?after=additions">
			<command label="Disable D builder" commandId="io.github.albert200000.dlangdt.project.addRemoveDNature" style="push">
				<visibleWhen checkEnabled="false">
					<with variable="selection">
						<count value="1"></count>
						<iterate>
							<adapt type="org.eclipse.core.resources.IProject">
								<test property="org.eclipse.core.resources.projectNature" value="io.github.albert200000.dlangdt.project.DNature"></test>
							</adapt>
						</iterate>
					</with>
				</visibleWhen>
			</command>
			<command label="Enable D builder" commandId="io.github.albert200000.dlangdt.project.addRemoveDNature" style="push">
				<visibleWhen checkEnabled="false">
					<with variable="selection">
						<count value="1"></count>
						<iterate>
							<adapt type="org.eclipse.core.resources.IProject">
								<not>
									<test property="org.eclipse.core.resources.projectNature" value="io.github.albert200000.dlangdt.project.DNature"></test>
								</not>
							</adapt>
						</iterate>
					</with>
				</visibleWhen>
			</command>
		</menuContribution>
		<menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.navigator.ProjectExplorer#PopupMenu?after=additions">
			<menu id="io.github.albert200000.dlangdt.project.menus.gomod" label="Dub Commands"></menu>
		</menuContribution>
		<menuContribution locationURI="popup:io.github.albert200000.dlangdt.project.menus.gomod?after=additions">
			<command label="dub fetch" commandId="io.github.albert200000.dlangdt.project.gomod.commands.download" style="push">
				<visibleWhen>
					<with variable="activeMenuSelection">
						<iterate ifEmpty="false">
							<adapt type="org.eclipse.core.resources.IResource">
								<test property="org.eclipse.core.resources.name" value="dub.json" />
							</adapt>
						</iterate>
					</with>
				</visibleWhen>
			</command>
			<command label="dub fetch" commandId="io.github.albert200000.dlangdt.project.gomod.commands.tidy" style="push">
				<visibleWhen>
					<with variable="activeMenuSelection">
						<iterate ifEmpty="false">
							<adapt type="org.eclipse.core.resources.IResource">
								<test property="org.eclipse.core.resources.name" value="dub.json" />
							</adapt>
						</iterate>
					</with>
				</visibleWhen>
			</command>
			<command label="dub fetch" commandId="io.github.albert200000.dlangdt.project.gomod.commands.vendor" style="push">
				<visibleWhen>
					<with variable="activeMenuSelection">
						<iterate ifEmpty="false">
							<adapt type="org.eclipse.core.resources.IResource">
								<test property="org.eclipse.core.resources.name" value="dub.json" />
							</adapt>
						</iterate>
					</with>
				</visibleWhen>
			</command>
		</menuContribution>
	</extension>
	<extension id="xmlProblem" name="XML Problem" point="org.eclipse.core.resources.markers">
		<super type="org.eclipse.core.resources.problemmarker"></super>
		<persistent value="true"></persistent>
	</extension>
	<extension point="org.eclipse.ui.ide.projectNatureImages">
		<image icon="icons/d-nature.png" id="io.github.albert200000.dlangdt.project.natureimage" natureId="io.github.albert200000.dlangdt.project.DNature"></image>
	</extension>
	<extension point="org.eclipse.ui.newWizards">
		<category id="io.github.albert200000.dlangdt.project.wizards.category" name="Dlang"></category>
		<wizard canFinishEarly="false" category="io.github.albert200000.dlangdt.project.wizards.category" class="io.github.albert200000.dlangdt.project.wizards.DubModProjectWizard" hasPages="true" icon="icons/new-d-project.png" id="io.github.albert200000.dlangdt.project.wizards.DubModProject" name="Dub Mod Project" project="true">
			<description>New d project with dub init</description>
		</wizard>
	</extension>
</plugin>